# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings → API). Not needed yet for goal 1 (local dev works without
# it, using localStorage) — only required once goal 2 (accounts + database) is
# wired in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: shows the "Komunita" library tab (needs supabase/community.sql). Off by default.
# VITE_ENABLE_COMMUNITY=1
